# Database Username and Password
DB_USERNAME=""
DB_PASSWORD=""

# JWT Expiration Time Eg. 15m, 30d
ACCESS_TOKEN_LIFE=30m
REFRESH_TOKEN_LIFE=30d

# Node Environment Eg. 'development' or 'production'
NODE_ENV=development

REACT_APP_RAZORPAY_KEY_ID=<razor_pay_key_id>
RAZORPAY_SECRET=<razorpay_secret>
RAZORPAY_KEY_ID=<razorpay_key_id>

# Secret Keys
# Generate Using `node -e "console.log(require('crypto').randomBytes(256).toString('base64'));"`
JWT_SECRET=
# Generate Using `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
COOKIE_SECRET=
COOKIE_SECURE=false # false for HTTP, true for HTTPS

# --- Postgres ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST_PORT=
DATABASE_URL="postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?sslmode=disable"
